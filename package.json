{
  "name": "deepseek-harness-action",
  "version": "0.1.0",
  "description": "DeepSeek Harness for GitHub - AI Code Review, CI Diagnosis, Auto Fix, and Issue to PR",
  "author": "Lixiaoyiao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lixiaoyiao/deepseek-harness-action.git"
  },
  "private": false,
  "license": "MIT",
  "keywords": [
    "github-action",
    "deepseek",
    "code-review",
    "ci",
    "automation"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "ncc build src/index.ts -o dist --minify --source-map",
    "build:check": "npm run build && git diff --exit-code -- dist/ && git diff --cached --exit-code -- dist/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:dsh-config": "node scripts/verify-dsh-config.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:dsh-config && npm run build:check"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@vercel/ncc": "0.45.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
